const int k=4;

// 1) Unbounded probabilistic reachability (still fine)
<<p1:p2>>max=? ( P[F s=1] + P[F s=1] )

// 2) Bounded probabilistic reachability (needs larger horizon now!)
<<p1:p2>>max=? ( P[F<=k s=1] + P[F<=k s=1] )

// 3) Bounded cumulative rewards (now meaningful with loop)
<<p1:p2>>max=? ( R{"r1"}[C<=k] + R{"r2"}[C<=k] )

// 4) Unbounded reachability reward
<<p1:p2>>max=? ( R{"r1"}[F s=1] + R{"r2"}[F s=1] )

// 5) Loop-avoidance (new, important)
// <<p1:p2>>max=? ( P[F<=k s=3] )