csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule


module recorder
    s : [0..3] init 0;

    [a1,a2] (s=0) -> [0.4,0.5]:(s'=1) + [0.5,0.6]:(s'=2);
    [a1,b2] (s=0) -> [0.2,0.3]:(s'=1) + [0.7,0.8]:(s'=3);
    [b1,a2] (s=0) -> (s'=1);
    [b1,b2] (s=0) -> [0.01,0.1]:(s'=1) + [0.9,1.0]:(s'=2);

    [] (s=1) -> (s'=1); // target
    [] (s=2) -> (s'=2);
    [] (s=3) -> (s'=3);
endmodule