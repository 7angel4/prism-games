csg

player p1 m1 endplayer
player p2 m2 endplayer

// first player
module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

// second player
module m2 = m1[a1=a2,b1=b2] endmodule

// state recorder
module recorder
    // 0: start, 1: good target, 2: bad target, 3: loop state
    s : [0..3] init 0;

    // ---- From start (s0) ----
    // coordination needed for best outcome
    [a1,a2] (s=0) -> 0.7:(s'=1) + 0.3:(s'=3);  // good but can fall into loop
    [a1,b2] (s=0) -> 0.4:(s'=3) + 0.6:(s'=2);  // mismatch → bad
    [b1,a2] (s=0) -> 0.4:(s'=3) + 0.6:(s'=2);  // symmetric mismatch
    [b1,b2] (s=0) -> 0.6:(s'=1) + 0.4:(s'=3);  // safer but weaker

    // ---- Loop state (s3) ----
    // requires coordination to escape
    [a1,a2] (s=3) -> 0.6:(s'=1) + 0.4:(s'=3);
    [a1,b2] (s=3) -> 0.2:(s'=1) + 0.8:(s'=3);
    [b1,a2] (s=3) -> 0.2:(s'=1) + 0.8:(s'=3);
    [b1,b2] (s=3) -> 0.1:(s'=1) + 0.9:(s'=3);

    // ---- absorbing states ----
    [] (s=1) -> (s'=1);
    [] (s=2) -> (s'=2);
endmodule

// player 1 prefers fast success
rewards "r1"
    s=1 : 1;
    s=2 : 0;
endrewards

// player 2 slightly risk-averse (penalise loop implicitly via delay)
rewards "r2"
    s=1 : 1;
    s=2 : 0;
endrewards