// Two robots moving over a grid
// One tries to move from the SW corner to the NE corner while the other does the reverse
// When moving, a robot can end up in an adjacent grid square with probability q

// concurrent game model
csg

// the players
player robot1 robot1 endplayer
player robot2 robot2 endplayer

const double q; // probability of movement failure
const int l; // size of grid
const double eps; // small value for transition uncertainty

// corner points
const int xmin = 0;
const int ymin = 0;
const int xmax = l-1;
const int ymax = l-1;

// initial grid positions for the robots
const int xi1 = xmin; const int yi1 = ymin;
const int xi2 = xmax; const int yi2 = ymax;

// goal grid positions for the robots
const int xg1 = xmax; const int yg1 = ymax;
const int xg2 = xmin; const int yg2 = ymin;

// add labels for specifying properties
label "goal1" = x1=xg1 & y1=yg1;
label "goal2" = x2=xg2 & y2=yg2;

// robots crash when they end up in same grid square
label "crash" = x1=x2 & y1=y2;

// first robot
module robot1
    x1 : [xmin..xmax] init xi1;
    y1 : [ymin..ymax] init yi1;

    [n1] y1<ymax ->
        [max(0, 1-q-eps), min(1, 1-q+eps)] : (y1'=y1+1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (y1'=y1+1) & (x1'=min(xmax,x1+1))
        + [max(0, q/2-eps), min(1, q/2+eps)] : (y1'=y1+1) & (x1'=max(xmin,x1-1));

    [e1] x1<xmax ->
        [max(0, 1-q-eps), min(1, 1-q+eps)] : (x1'=x1+1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (x1'=x1+1) & (y1'=min(ymax,y1+1))
        + [max(0, q/2-eps), min(1, q/2+eps)] : (x1'=x1+1) & (y1'=max(ymin,y1-1));

    [ne1] y1<ymax & x1<xmax ->
        [max(0, 1-q-eps), min(1, 1-q+eps)] : (y1'=y1+1) & (x1'=x1+1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (y1'=y1+1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (x1'=x1+1);

    [done1] y1=yg1 & x1=xg1 -> true;
endmodule

// second robot with interval transitions
module robot2
    x2 : [xmin..xmax] init xi2;
    y2 : [ymin..ymax] init yi2;

    [s2] y2>ymin ->
        [max(0, 1-q-eps), min(1, 1-q+eps)] : (y2'=y2-1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (y2'=y2-1) & (x2'=min(xmax,x2+1))
        + [max(0, q/2-eps), min(1, q/2+eps)] : (y2'=y2-1) & (x2'=max(xmin,x2-1));

    [w2] x2>xmin ->
        [max(0, 1-q-eps), min(1, 1-q+eps)] : (x2'=x2-1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (x2'=x2-1) & (y2'=min(ymax,y2+1))
        + [max(0, q/2-eps), min(1, q/2+eps)] : (x2'=x2-1) & (y2'=max(ymin,y2-1));

    [sw2] y2>ymin & x2>xmin ->
        [max(0, 1-q-eps), min(1, 1-q+eps)] : (y2'=y2-1) & (x2'=x2-1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (y2'=y2-1)
        + [max(0, q/2-eps), min(1, q/2+eps)] : (x2'=x2-1);

    [done2] y2=yg2 & x2=xg2 -> true;
endmodule

// rewards unchanged
rewards "time1"
    [] !(x1=x2 & y1=y2) & !(y1=yg1 & x1=xg1) : 1;
    [] x1=x2 & y1=y2 & !(y1=yg1 & x1=xg1) : 10;
endrewards

rewards "time2"
    [] !(x1=x2 & y1=y2) & !(y2=yg2 & x2=xg2) : 1;
    [] x1=x2 & y1=y2 & !(y2=yg2 & x2=xg2) : 10;
endrewards
