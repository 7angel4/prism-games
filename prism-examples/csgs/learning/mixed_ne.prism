csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [push1] true -> true;
    [wait1] true -> true;
endmodule

module m2 = m1[push1=push2,wait1=wait2] endmodule

module game
    s : [0..3] init 0;
    // 0 = conflict
    // 1 = p1 target
    // 2 = p2 target
    // 3 = reset loop

    // both push → random winner
    [push1,push2] s=0 -> 0.5:(s'=1) + 0.5:(s'=2);

    // unilateral push → that player wins
    [push1,wait2] s=0 -> (s'=1);
    [wait1,push2] s=0 -> (s'=2);

    // both wait → reset
    [wait1,wait2] s=0 -> (s'=3);

    // reset sends back to conflict
    [] s=3 -> (s'=0);

    // absorbing targets
    [] s=1 -> (s'=1);
    [] s=2 -> (s'=2);
endmodule