csg

player user1 node1 endplayer
player user2 node2 endplayer

module node1
    [tx1] true -> true;      // transmit
    [wait1] true -> true;    // defer
endmodule

module node2 = node1[tx1=tx2,wait1=wait2] endmodule

module channel
    s : [0..5] init 0;
    // 0 = contention slot
    // 1 = user1 successful transmission
    // 2 = user2 successful transmission
    // 3 = collision / retry
    // 4 = terminal success (user1)
    // 5 = terminal success (user2)

    // contention outcomes (matching-pennies structure)
    [tx1,tx2] s=0 -> (s'=2);       // collision resolved in favour of user2
    [wait1,wait2] s=0 -> (s'=2);   // idle slot wasted → user2 advantage
    [tx1,wait2] s=0 -> (s'=1);     // user1 succeeds
    [wait1,tx2] s=0 -> (s'=1);     // user1 benefits from asymmetry

    // stochastic resolution phase
    [] s=1 -> 0.8:(s'=4) + 0.2:(s'=3);
    [] s=2 -> 0.8:(s'=5) + 0.2:(s'=3);

    // retry loop (contention repeats)
    [] s=3 -> (s'=0);

    // absorbing success states
    [] s=4 -> (s'=4);
    [] s=5 -> (s'=5);
endmodule

label "success1" = s=4;
label "success2" = s=5;

rewards "throughput1"
    s=4 : 1;
endrewards

rewards "throughput2"
    s=5 : 1;
endrewards