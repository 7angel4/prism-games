csg

// Generated by generate_models.py -- |S| scaling family (hub variant of Safe vs Risky)
// c = 2 channels per joint action; |S| = 12

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..11] init 0; // 0 start; 1..8 channels; 9 high, 10 medium, 11 trap

    [a1,a2] s=0 -> 1/2:(s'=1) + 1/2:(s'=2);
    [a1,b2] s=0 -> 1/2:(s'=3) + 1/2:(s'=4);
    [b1,a2] s=0 -> 1/2:(s'=5) + 1/2:(s'=6);
    [b1,b2] s=0 -> 1/2:(s'=7) + 1/2:(s'=8);

    [] s=1 -> 0.95:(s'=9) + 0.05:(s'=11); // channel for [a1,a2]
    [] s=2 -> 0.85:(s'=9) + 0.15:(s'=11); // channel for [a1,a2]
    [] s=3 -> 0.55:(s'=9) + 0.45:(s'=11); // channel for [a1,b2]
    [] s=4 -> 0.45:(s'=9) + 0.55:(s'=11); // channel for [a1,b2]
    [] s=5 -> 0.55:(s'=9) + 0.45:(s'=11); // channel for [b1,a2]
    [] s=6 -> 0.45:(s'=9) + 0.55:(s'=11); // channel for [b1,a2]
    [] s=7 -> 0.65:(s'=9) + 0.35:(s'=10); // channel for [b1,b2]
    [] s=8 -> 0.55:(s'=9) + 0.45:(s'=10); // channel for [b1,b2]

    [] s>=9 -> (s'=s); // absorbing
endmodule

label "high" = s=9;
label "medium" = s=10;

rewards "r1"
    s=9 : 1;
    s=10 : 0.6;
endrewards

rewards "r2"
    s=9 : 1;
    s=10 : 0.6;
endrewards
