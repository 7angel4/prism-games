csg

// Generated by generate_models.py -- |A| scaling family of Safe vs Risky
// m = 3 actions per player; |A| = 9 joint actions; |S| = 4

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [x1_1] true -> true;
    [x1_2] true -> true;
    [x1_3] true -> true;
endmodule

module m2 = m1[x1_1=x2_1,x1_2=x2_2,x1_3=x2_3] endmodule

module game
    s : [0..3] init 0; // 0 start, 1 high, 2 medium, 3 trap

    [x1_1,x2_1] s=0 -> 0.9:(s'=1) + 0.1:(s'=3);
    [x1_1,x2_2] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [x1_1,x2_3] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [x1_2,x2_1] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [x1_2,x2_2] s=0 -> 0.6:(s'=1) + 0.4:(s'=2);
    [x1_2,x2_3] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [x1_3,x2_1] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [x1_3,x2_2] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [x1_3,x2_3] s=0 -> 0.55:(s'=1) + 0.45:(s'=2);

    [] s>0 -> (s'=s); // absorbing
endmodule

label "high" = s=1;
label "medium" = s=2;

rewards "r1"
    s=1 : 1;
    s=2 : 0.6;
endrewards

rewards "r2"
    s=1 : 1;
