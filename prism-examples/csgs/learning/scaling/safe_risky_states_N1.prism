csg

// Generated by generate_models.py -- |S| scaling family (hub variant of Safe vs Risky)
// c = 1 channels per joint action; |S| = 8

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..7] init 0; // 0 start; 1..4 channels; 5 high, 6 medium, 7 trap

    [a1,a2] s=0 -> 1/1:(s'=1);
    [a1,b2] s=0 -> 1/1:(s'=2);
    [b1,a2] s=0 -> 1/1:(s'=3);
    [b1,b2] s=0 -> 1/1:(s'=4);

    [] s=1 -> 0.9:(s'=5) + 0.1:(s'=7); // channel for [a1,a2]
    [] s=2 -> 0.5:(s'=5) + 0.5:(s'=7); // channel for [a1,b2]
    [] s=3 -> 0.5:(s'=5) + 0.5:(s'=7); // channel for [b1,a2]
    [] s=4 -> 0.6:(s'=5) + 0.4:(s'=6); // channel for [b1,b2]

    [] s>=5 -> (s'=s); // absorbing
endmodule

label "high" = s=5;
label "medium" = s=6;

rewards "r1"
    s=5 : 1;
    s=6 : 0.6;
endrewards

rewards "r2"
    s=5 : 1;
    s=6 : 0.6;
endrewards
