{\*\expandedcolortbl;;}
\paperw11900\paperh16840\margl1440\margr1440\vieww11520\viewh8400\viewkind0
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0

\f0\fs24 \cf0 csg\
\
player p1 m1 endplayer\
player p2 m2 endplayer\
\
module m1\
    [risk1] true -> true;\
    [safe1] true -> true;\
endmodule\
\
module m2 = m1[risk1=risk2,safe1=safe2] endmodule\
\
module game\
    s : [0..5] init 0;\
\
    [risk1,risk2] s=0 -> (s'=1);\
    [safe1,safe2] s=0 -> (s'=3);\
    [risk1,safe2] s=0 -> (s'=4);\
    [safe1,risk2] s=0 -> (s'=4);\
\
    [] s=1 -> 0.8:(s'=1) + 0.2:(s'=4);\
    [] s=3 -> 0.95:(s'=5) + 0.05:(s'=3);\
\
    [] s=4 -> (s'=4);\
    [] s=5 -> (s'=5);\
endmodule\
\
rewards "r1"\
    s=5 : 1;\
endrewards\
\
rewards "r2"\
    s=5 : 1;\
endrewards}