csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..2] init 0;

    // cyclic preferences (no pure NE)
    [a1,a2] s=0 -> (s'=1);
    [a1,b2] s=0 -> (s'=2);
    [b1,a2] s=0 -> (s'=2);
    [b1,b2] s=0 -> (s'=1);

    [] s>0 -> (s'=s);
endmodule

rewards "r1"
    s=1 : 1;
    s=2 : 0;
endrewards

rewards "r2"
    s=1 : 0;
    s=2 : 1;
endrewards