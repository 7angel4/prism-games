csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true; // risky
    [b1] true -> true; // safe
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..3] init 0;

    // risky (looks good)
    [a1,a2] s=0 -> 0.85:(s'=1) + 0.15:(s'=3);

    // safe (slightly worse)
    [b1,b2] s=0 -> 0.6:(s'=1) + 0.4:(s'=2);

    // mismatch = failure
    [a1,b2] s=0 -> (s'=3);
    [b1,a2] s=0 -> (s'=3);

    [] s>0 -> (s'=s);
endmodule

rewards "r1"
    s=1 : 10;
    s=2 : 5;
    s=3 : -20;
    [] true : -1;
endrewards

rewards "r2"
    s=1 : 10;
    s=2 : 5;
    s=3 : -20;
    [] true : -1;
endrewards