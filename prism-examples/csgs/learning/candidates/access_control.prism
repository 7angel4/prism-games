csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [access1] true -> true;
    [wait1] true -> true;
endmodule

module m2 = m1[access1=access2, wait1=wait2] endmodule

module env
    s : [0..3] init 0;
    // 0: start
    // 1: success
    // 2: collision
    // 3: waiting loop

    // both access → collision
    [access1,access2] (s=0) -> 1:(s'=2);

    // one accesses → success
    [access1,wait2] (s=0) -> 1:(s'=1);
    [wait1,access2] (s=0) -> 1:(s'=1);

    // both wait → loop
    [wait1,wait2] (s=0) -> 1:(s'=3);

    // --- ensure convergence ---

    // success absorbing
    [] (s=1) -> (s'=1);

    // collision eventually resolves
    [] (s=2) -> 0.9:(s'=2) + 0.1:(s'=1);

    // waiting eventually leads to success
    [] (s=3) -> 0.9:(s'=3) + 0.1:(s'=1);
endmodule

rewards "r1"
    (s=1) : 5;
    (s=2) : -2;
endrewards

rewards "r2"
    (s=1) : 5;
    (s=2) : -2;
endrewards

rewards "r_sum"
    (s=1) : 10;
    (s=2) : -4;
endrewards