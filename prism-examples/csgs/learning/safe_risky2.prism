csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..5] init 0;
    // 0 = play
    // 1 = p1 win
    // 2 = p2 win
    // 3 = draw (loops back)
    // 4 = terminal good
    // 5 = terminal bad

    // matching pennies structure
    [a1,a2] s=0 -> (s'=2); // p2 wins
    [b1,b2] s=0 -> (s'=2); // p2 wins
    [a1,b2] s=0 -> (s'=1); // p1 wins
    [b1,a2] s=0 -> (s'=1); // p1 wins

    // stochastic continuation to make it a proper CSG
    [] s=1 -> 0.8:(s'=4) + 0.2:(s'=3);
    [] s=2 -> 0.8:(s'=5) + 0.2:(s'=3);

    // loop (forces repeated interaction → mixing matters)
    [] s=3 -> (s'=0);

    // absorbing
    [] s=4 -> (s'=4);
    [] s=5 -> (s'=5);
endmodule

label "goal1" = s=4;
label "goal2" = s=5;

rewards "r1"
    s=4 : 1;
endrewards

rewards "r2"
    s=5 : 1;
endrewards