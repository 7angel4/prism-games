{\colortbl;\red255\green255\blue255;}
{\*\expandedcolortbl;;}
\paperw11900\paperh16840\margl1440\margr1440\vieww11520\viewh8400\viewkind0
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0

\f0\fs24 \cf0 csg\
\
player p1 m1 endplayer\
player p2 m2 endplayer\
\
module m1\
    [high1] true -> true;\
    [low1] true -> true;\
endmodule\
\
module m2 = m1[high1=high2,low1=low2] endmodule\
\
module system\
    s : [0..3] init 0; // 0=start,1=high,2=low,3=fail\
\
    // both high \uc0\u8594  risky\
    [high1,high2] s=0 -> 0.7:(s'=1) + 0.3:(s'=3);\
\
    // both low \uc0\u8594  safe\
    [low1,low2] s=0 -> (s'=2);\
\
    // mixed \uc0\u8594  unstable\
    [high1,low2] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);\
    [low1,high2] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);\
\
    [] s=1 -> (s'=1);\
    [] s=2 -> (s'=2);\
    [] s=3 -> (s'=3);\
endmodule\
\
rewards "r1"\
    s=1 : 1;\
    s=2 : 0.6;\
endrewards\
\
rewards "r2"\
    s=1 : 1;\
    s=2 : 0.6;\
endrewards}