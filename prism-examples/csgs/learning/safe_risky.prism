csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..3] init 0; // 0 start, 1 high, 2 medium, 3 trap

    // joint actions
    [a1,a2] s=0 -> 0.9:(s'=1) + 0.1:(s'=3); // risky
    [b1,b2] s=0 -> 0.6:(s'=1) + 0.4:(s'=2); // safe
    [a1,b2] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);
    [b1,a2] s=0 -> 0.5:(s'=1) + 0.5:(s'=3);

    [] s>0 -> (s'=s); // absorbing
endmodule

rewards "r1"
    s=1 : 1;
    s=2 : 0.6;
    s=3 : 0;
endrewards

rewards "r2"
    s=1 : 1;
    s=2 : 0.6;
    s=3 : 0;
endrewards