csg

player defender def endplayer
player attacker att endplayer

module def
    [d1] true -> true; // weak defense
    [d2] true -> true; // strong defense
endmodule

module att = def[d1=a1,d2=a2] endmodule

module system
    s : [0..2] init 0; 
    // 0 = healthy, 1 = compromised, 2 = failure

    // healthy
    [d1,a1] s=0 -> (s'=0);
    [d1,a2] s=0 -> 0.7:(s'=1) + 0.3:(s'=0);
    [d2,a1] s=0 -> 0.9:(s'=0) + 0.1:(s'=1);
    [d2,a2] s=0 -> (s'=0);

    // compromised
    [d1,a1] s=1 -> 0.6:(s'=0) + 0.4:(s'=1);
    [d1,a2] s=1 -> 0.7:(s'=2) + 0.3:(s'=1);
    [d2,a1] s=1 -> 0.5:(s'=1) + 0.5:(s'=2);
    [d2,a2] s=1 -> 0.6:(s'=0) + 0.4:(s'=1);

    // failure (absorbing)
    [] s=2 -> (s'=2);
endmodule

// defender wants LOW damage
rewards "defender"
    s=0 : 0;
    s=1 : 1;
    s=2 : 3;
endrewards

// attacker wants HIGH damage
rewards "attacker"
    s=0 : 0;
    s=1 : 1;
    s=2 : 3;
endrewards