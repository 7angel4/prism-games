csg

player p1 m1 endplayer
player p2 m2 endplayer

module m1
    [a1] true -> true;
    [b1] true -> true;
endmodule

module m2 = m1[a1=a2,b1=b2] endmodule

module game
    s : [0..3] init 0;

    // core cycle
    [a1,a2] s=0 -> (s'=1); // toward p1 goal
    [a1,b2] s=0 -> (s'=2); // toward p2 goal
    [b1,a2] s=0 -> (s'=2);
    [b1,b2] s=0 -> (s'=1);

    // redirect loop (conflicting control)
    [] s=1 -> 0.8:(s'=1) + 0.19:(s'=0) + 0.01:(s'=3); // p1 likes staying
    [] s=2 -> 0.8:(s'=2) + 0.19:(s'=0) + 0.01:(s'=3); // p2 likes staying
    [] s=3 -> (s'=3);
endmodule

rewards "r1"
    s=1 : 1;
endrewards

rewards "r2"
    s=2 : 1;
endrewards