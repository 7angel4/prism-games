// 1) Unbounded reachability 
<<p1:p2>>max=? ( P[F "goal"] + P[F "goal"] )

// 2) Bounded reachability (hard exploration signal)
const int k=5;
// <<p1:p2>>max=? ( P[F<=k "goal"] + P[F<=k "goal"] )
// Equivalent to bounded cumulative rewards
<<p1:p2>>max=? ( R{"r1"}[C<=k] + R{"r2"}[C<=k] )

<<p1>>R{"r1"}max=? [C<=k]

// 3) Unbounded reachability reward
<<p1:p2>>max=? ( R{"r1"}[F "goal"] + R{"r2"}[F "goal"] )